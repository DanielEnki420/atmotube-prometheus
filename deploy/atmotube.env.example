# /etc/atmotube.env - copy, then: sudo chmod 600 /etc/atmotube.env
# Everything is optional, but pin your device: without ATMOTUBE_MAC the exporter
# listens to the first Atmotube it hears, which might be a neighbour's.
# `python3 atmotube.py --diagnose` prints the address.
ATMOTUBE_MAC=

# Where node_exporter's textfile collector looks (Debian/Raspberry Pi OS default):
#ATMOTUBE_METRICS_FILE=/var/lib/prometheus/node-exporter/atmotube.prom

# Alerts: any executable, called as <command> <title> <text>. Empty = log only.
#ATMOTUBE_NOTIFY_CMD=/opt/atmotube-prometheus/examples/notify-telegram.sh
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=
#ATMOTUBE_ROOM=Living room
#ATMOTUBE_LANG=en              # alert texts: en or de
#ATMOTUBE_QUIET_HOURS=22-7

# Thresholds: alert from HIGH (for a minimum duration), clear only below OK.
#ATMOTUBE_PM25_HIGH=25
#ATMOTUBE_PM25_OK=15
#ATMOTUBE_VOC_HIGH=1000        # ppb
#ATMOTUBE_VOC_OK=500
#ATMOTUBE_HUMIDITY_HIGH=65
#ATMOTUBE_HUMIDITY_OK=60
#ATMOTUBE_BATTERY_LOW=15
#ATMOTUBE_BATTERY_OK=30

# GATT fallback when BlueZ swallows one of the two advertisement packets:
#ATMOTUBE_GATT=auto            # or: never
#ATMOTUBE_GATT_AFTER=120       # s without a packet type before reading over GATT
#ATMOTUBE_GATT_INTERVAL=120    # connect at most this often

# Timing and freshness:
#ATMOTUBE_LISTEN_SECONDS=20
#ATMOTUBE_PAUSE_SECONDS=10
#ATMOTUBE_MAX_AGE=600          # s, older base readings are dropped, not repeated
#ATMOTUBE_MAX_AGE_PM=1800      # the PM sensor may measure only every few minutes
